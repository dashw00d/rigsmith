{
  "name": "rigsmith",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview --open",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:godot": "godot --headless --script tests/godot/check_export.gd --",
    "library": "python3 blender/library/build.py all",
    "lint": "eslint .",
    "volume": ".venv/bin/python tools/volume/build.py",
    "setup:python": "uv venv --python 3.12 .venv && uv pip install --python .venv/bin/python -r tools/requirements.txt && uv pip install --python .venv/bin/python -r tools/requirements-torch.txt",
    "retopo": ".venv/bin/python tools/retopo/retopo.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@comfyorg/fbx-exporter-three": "^1.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.57.0",
    "jszip": "^3.10.1",
    "meshoptimizer": "^1.3.0",
    "svelte": "^5.57.2",
    "three": "^0.185.0"
  },
  "description": "Personal character pipeline: import, auto-rig, outfit, paint, animate and export to Godot."
}
